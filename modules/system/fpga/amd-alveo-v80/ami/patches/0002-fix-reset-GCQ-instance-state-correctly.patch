From 5777550c2fae7c6daebc2ea558482d7c373a3224 Mon Sep 17 00:00:00 2001
From: hakan-demirli <ehdemirli@proton.me>
Date: Wed, 9 Sep 2026 23:08:28 +0200
Subject: [PATCH 02/16] fix: reset GCQ instance state correctly

---
 driver/gcq-driver/src/gcq_driver.c   | 8 ++++----
 driver/gcq-driver/src/gcq_hw.c       | 2 +-
 driver/gcq-driver/src/gcq_internal.h | 1 +
 3 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/driver/gcq-driver/src/gcq_driver.c b/driver/gcq-driver/src/gcq_driver.c
index f7e268b..1cc5a29 100644
--- a/driver/gcq-driver/src/gcq_driver.c
+++ b/driver/gcq-driver/src/gcq_driver.c
@@ -23,7 +23,7 @@
 #define GCQ_INSTANCE_UPPER_FIREWALL     ( 0xBEEFCAFE )
 #define GCQ_INSTANCE_LOWER_FIREWALL     ( 0xDEADFACE )
 
-#define CHECK_ATTACHED( f )             ( ( GCQ_MODE_TYPE_CONSUMER_MODE == f->xMode ) && ( GCQ_FALSE == pxThis->ucConsumerAttached ) )
+#define CHECK_ATTACHED( f )             ( ( GCQ_MODE_TYPE_CONSUMER_MODE == f->xMode ) && ( GCQ_FALSE == f->ucConsumerAttached ) )
 #define CHECK_FIREWALLS( f )            ( ( f->ulUpperFirewall != GCQ_INSTANCE_UPPER_FIREWALL ) || \
                                           ( f->ulLowerFirewall != GCQ_INSTANCE_LOWER_FIREWALL ) )
 
@@ -51,7 +51,6 @@ typedef struct GCQ_PRIVATE_DATA
 {
     uint32_t            ulUpperFirewall;
  
-    uint8_t             ucConsumerAttached;
     uint8_t             ucInstancesAllocated;
     GCQ_INSTANCE_TYPE   xGCQInstances[ GCQ_MAX_INSTANCES ];
     
@@ -68,7 +67,6 @@ static GCQ_PRIVATE_DATA xLocalData =
 {
     GCQ_INSTANCE_UPPER_FIREWALL,     /* ulUpperFirewall */
 
-    GCQ_FALSE,                       /* ucConsumerAttached */
     0,                               /* ucInstancesAllocated */
     { { 0 } },                       /* xGCQInstances */
 
@@ -503,6 +501,7 @@ GCQ_ERRORS_TYPE xGCQInit( struct GCQ_INSTANCE_TYPE **ppxGCQInstance,
                                 ulCQSlotSize );
 
             ( *ppxGCQInstance )->iInitialised = GCQ_FALSE;
+            ( *ppxGCQInstance )->ucConsumerAttached = GCQ_FALSE;
             ( *ppxGCQInstance )->xMode = xMode;
             ( *ppxGCQInstance )->xIntMode = xIntMode;
             ( *ppxGCQInstance )->xGCQFlags = xflags;
@@ -565,6 +564,7 @@ GCQ_ERRORS_TYPE xGCQDeinit( struct GCQ_INSTANCE_TYPE *pxGCQInstance )
         else
         {
             pxGCQInstance->iInitialised = GCQ_FALSE;
+            pxGCQInstance->ucConsumerAttached = GCQ_FALSE;
             pxThis->ucInstancesAllocated--;
         }
     }
@@ -665,7 +665,7 @@ GCQ_ERRORS_TYPE xGCQAttachConsumer( struct GCQ_INSTANCE_TYPE *pxGCQInstance )
             else
             {
                 /* Set flag to show now attached */
-                pxThis->ucConsumerAttached = GCQ_TRUE;
+                pxGCQInstance->ucConsumerAttached = GCQ_TRUE;
             }
         }
     }
diff --git a/driver/gcq-driver/src/gcq_hw.c b/driver/gcq-driver/src/gcq_hw.c
index bf058a3..7815930 100644
--- a/driver/gcq-driver/src/gcq_hw.c
+++ b/driver/gcq-driver/src/gcq_hw.c
@@ -62,7 +62,7 @@ GCQ_ERRORS_TYPE xGCQHWInit( GCQ_MODE_TYPE xMode,
                  * The reset field is self-clearing once set.
                  */
                 ulValue = pxGCQIOAccess->xGCQReadReg32( ( ullBaseAddr + GCQ_PRODUCER_SQ_RESET_INTERRUPT_CTRL ) );
-                ulValue |= FIELD_SET( GCQ_PRODUCER_SQ_RESET_INTERRUPT_CTRL_ENABLE_MASK, GCQ_INTERRUPT_CTRL_RESET );
+                ulValue |= FIELD_SET( GCQ_PRODUCER_SQ_RESET_INTERRUPT_CTRL_RESET_MASK, GCQ_INTERRUPT_CTRL_RESET );
                 pxGCQIOAccess->xGCQWriteReg32( ( ullBaseAddr + GCQ_PRODUCER_SQ_RESET_INTERRUPT_CTRL ), ulValue );
                 ulValue = FIELD_SET( GCQ_PRODUCER_SQ_QUEUE_MEM_ADDR_LOW, GCQ_HW_LOWER_32 ( ullRingAddr ) );
                 pxGCQIOAccess->xGCQWriteReg32( ( ullBaseAddr + GCQ_PRODUCER_SQ_QUEUE_MEM_ADDR_LOW ), ulValue );
diff --git a/driver/gcq-driver/src/gcq_internal.h b/driver/gcq-driver/src/gcq_internal.h
index e785131..044a429 100644
--- a/driver/gcq-driver/src/gcq_internal.h
+++ b/driver/gcq-driver/src/gcq_internal.h
@@ -79,6 +79,7 @@ typedef struct GCQ_INSTANCE_TYPE
     int      iInitialised;
     uint64_t ullBaseAddr;
     GCQ_MODE_TYPE xMode;
+    uint8_t ucConsumerAttached;
     GCQ_INTERRUPT_MODE_TYPE xIntMode;
     const GCQ_IO_ACCESS_TYPE *pxGCQIOAccess;
     uint64_t ullRingAddr;
