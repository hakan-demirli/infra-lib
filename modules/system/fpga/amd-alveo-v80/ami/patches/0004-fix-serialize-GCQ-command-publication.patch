---
 driver/amc_proxy.c | 116 +++++++++++++++++----------------------------
 1 file changed, 43 insertions(+), 73 deletions(-)

diff --git a/driver/amc_proxy.c b/driver/amc_proxy.c
index 615908e..d8325c2 100644
--- a/driver/amc_proxy.c
+++ b/driver/amc_proxy.c
@@ -795,6 +795,33 @@ static struct amc_proxy_list_entry * amc_proxy_find_matching_proxy_instance(cons
         return (NULL);
 }
 
+static int amc_proxy_submit_request(struct amc_proxy_instance *inst,
+                                    struct amc_proxy_cmd_struct *cmd,
+                                    struct amc_proxy_cmd_request *request)
+{
+        uint32_t ret = FW_IF_ERRORS_INVALID_HANDLE;
+
+        if (!inst || !cmd || !request)
+                return -EINVAL;
+
+        mutex_lock(&inst->lock);
+        if (inst->initialised) {
+                ret = inst->fw_if_handle->write(inst->fw_if_handle, 0,
+                                                (uint8_t *)request,
+                                                sizeof(*request), 0);
+                if (ret == FW_IF_ERRORS_NONE)
+                        list_add_tail(&cmd->cmd_list, &inst->submitted_cmds);
+        }
+        mutex_unlock(&inst->lock);
+
+        if (ret != FW_IF_ERRORS_NONE) {
+                PR_ERR("FW_IF write request failed: %d", ret);
+                return -EIO;
+        }
+
+        return 0;
+}
+
 
