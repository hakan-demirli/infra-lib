From a534d4230b3a786816fc7b034a8c5bdf80bcd371 Mon Sep 17 00:00:00 2001
From: hakan-demirli <ehdemirli@proton.me>
Date: Wed, 9 Sep 2026 23:53:11 +0200
Subject: [PATCH 10/16] fix: validate AMC shared memory layout

---
 driver/ami_amc_control.c | 63 ++++++++++++++++++++++++++++++++++++----
 driver/ami_amc_control.h |  2 ++
 2 files changed, 59 insertions(+), 6 deletions(-)

diff --git a/driver/ami_amc_control.c b/driver/ami_amc_control.c
index e3cb4c5..1f7e5fc 100644
--- a/driver/ami_amc_control.c
+++ b/driver/ami_amc_control.c
@@ -155,6 +155,49 @@ static int get_sensor_id(int cmd_req, int flags)
 	return id;
 }
 
+static bool amc_range_is_valid(struct amc_control_ctxt *amc_ctrl_ctxt,
+	uint32_t offset, uint32_t length)
+{
+	return length && offset < amc_ctrl_ctxt->gcq_payload_len &&
+		length <= amc_ctrl_ctxt->gcq_payload_len - offset;
+}
+
+static bool amc_shared_mem_is_valid(struct amc_control_ctxt *amc_ctrl_ctxt,
+	struct amc_shared_mem *shared_mem)
+{
+	uint32_t min_ring_len = (11 * sizeof(uint32_t)) +
+		(2 * (AMC_PROXY_REQUEST_SIZE + AMC_PROXY_RESPONSE_SIZE));
+
+	if (shared_mem->amc_magic_no != AMC_GCQ_MAGIC_NO)
+		return false;
+
+	if ((shared_mem->ring_buffer.ring_buffer_off & 0x3) ||
+		shared_mem->ring_buffer.ring_buffer_len < min_ring_len ||
+		!amc_range_is_valid(amc_ctrl_ctxt,
+			shared_mem->ring_buffer.ring_buffer_off,
+			shared_mem->ring_buffer.ring_buffer_len))
+		return false;
+
+	if ((shared_mem->status.amc_status_off & 0x3) ||
+		shared_mem->status.amc_status_len < sizeof(uint32_t) ||
+		!amc_range_is_valid(amc_ctrl_ctxt,
+			shared_mem->status.amc_status_off,
+			shared_mem->status.amc_status_len))
+		return false;
+
+	if (shared_mem->log_msg.log_msg_buf_len &&
+		!amc_range_is_valid(amc_ctrl_ctxt,
+			shared_mem->log_msg.log_msg_buf_off,
+			shared_mem->log_msg.log_msg_buf_len))
+		return false;
+
+	if (shared_mem->data.amc_data_start >= shared_mem->data.amc_data_end ||
+		shared_mem->data.amc_data_end > amc_ctrl_ctxt->gcq_payload_len)
+		return false;
+
+	return true;
+}
+
 /**
  * get_aid() - Get the API ID.
  * @cmd_req: The command to be submitted.
@@ -215,14 +258,23 @@ int get_aid(int cmd_req, int flags)
 bool gcq_device_is_ready(struct amc_control_ctxt *amc_ctrl_ctxt)
 {
 	int i = 0, retry = DEVICE_READY_RETRY_COUNT, interval = DEVICE_READY_SLEEP_INTERVAL;
+	struct amc_shared_mem shared_mem = { 0 };
+	struct amc_shared_mem verification = { 0 };
 
 	if (!amc_ctrl_ctxt)
 		return false;
 
 	for (i = 0; i < retry; i++) {
 		msleep(interval);
-		memcpy_fromio(&(amc_ctrl_ctxt->amc_shared_mem),
-			amc_ctrl_ctxt->gcq_payload_base_virt_addr, sizeof(amc_ctrl_ctxt->amc_shared_mem));
+		memcpy_fromio(&shared_mem, amc_ctrl_ctxt->gcq_payload_base_virt_addr,
+			sizeof(shared_mem));
+		memcpy_fromio(&verification, amc_ctrl_ctxt->gcq_payload_base_virt_addr,
+			sizeof(verification));
+		if (memcmp(&shared_mem, &verification, sizeof(shared_mem)) ||
+			!amc_shared_mem_is_valid(amc_ctrl_ctxt, &shared_mem))
+			continue;
+
+		amc_ctrl_ctxt->amc_shared_mem = shared_mem;
 
 		AMI_VDBG(amc_ctrl_ctxt, "************ AMC Shared Memory ***************, virt_addr : %p",
 			amc_ctrl_ctxt->gcq_payload_base_virt_addr);
@@ -257,9 +309,6 @@ bool gcq_device_is_ready(struct amc_control_ctxt *amc_ctrl_ctxt)
 		AMI_VDBG(amc_ctrl_ctxt, "Offset of data buffer ended                    : 0x%x",
 			amc_ctrl_ctxt->amc_shared_mem.data.amc_data_end);
 
-		if (amc_ctrl_ctxt->amc_shared_mem.amc_magic_no == (uint32_t)-1)
-			continue;
-
 		if (amc_ctrl_ctxt->amc_shared_mem.amc_magic_no == AMC_GCQ_MAGIC_NO) {
 
 			uint32_t amc_status = 0;
@@ -271,7 +320,7 @@ bool gcq_device_is_ready(struct amc_control_ctxt *amc_ctrl_ctxt)
 				amc_ctrl_ctxt->amc_shared_mem.status.amc_status_off);
 
 			AMI_VDBG(amc_ctrl_ctxt, "Device status value : %x", amc_status);
-			if (amc_status) {
+			if (amc_status && amc_status != (uint32_t)-1) {
 				AMI_VDBG(amc_ctrl_ctxt,
 					"AMC GCQ service ready after %d ms",
 					interval * i);
@@ -852,6 +901,7 @@ static int map_amc_endpoints(struct pci_dev *dev, struct amc_control_ctxt *amc_c
 		ret = -EIO;
 		goto fail;
 	}
+	amc_ctrl_ctxt->gcq_payload_len = ep_gcq_payload.bar_len;
 
 	/* Map the Ring Buffer base address */
 	AMI_VDBG(amc_ctrl_ctxt, "Successfully mapped GCQ payload");
@@ -1694,6 +1744,7 @@ int setup_amc(struct pci_dev *dev, struct amc_control_ctxt **amc_ctrl_ctxt,
 	(*amc_ctrl_ctxt)->gcq_halted = true;
 	(*amc_ctrl_ctxt)->gcq_base_virt_addr = NULL;
 	(*amc_ctrl_ctxt)->gcq_payload_base_virt_addr = NULL;
+	(*amc_ctrl_ctxt)->gcq_payload_len = 0;
         (*amc_ctrl_ctxt)->heartbeat_thread_created = false;
         (*amc_ctrl_ctxt)->logging_thread_created = false;
 
diff --git a/driver/ami_amc_control.h b/driver/ami_amc_control.h
index de7ae23..d1aab76 100644
--- a/driver/ami_amc_control.h
+++ b/driver/ami_amc_control.h
@@ -632,6 +632,7 @@ struct amc_version {
  * struct amc_control_ctxt - context for the AMC.
  * @pcie_dev: the physical function
  * @gcq_payload_base_virt_addr: payload virtual base address
+ * @gcq_payload_len: payload mapping length
  * @gcq_base_virt_addr: the virtual base address
  * @amc_shared_mem: the shared memory base address
  * @gcq_ring_buf_base_virt_addr: the ring buffer virtual address
@@ -657,6 +658,7 @@ struct amc_version {
  struct amc_control_ctxt{
 	struct pci_dev          *pcie_dev;
 	void __iomem            *gcq_payload_base_virt_addr;
+	resource_size_t         gcq_payload_len;
 	void __iomem            *gcq_base_virt_addr;
 	struct amc_shared_mem   amc_shared_mem;
 	void __iomem            *gcq_ring_buf_base_virt_addr;
