From 50a5b074778977b400f1524df6b579630068dbb8 Mon Sep 17 00:00:00 2001
From: hakan-demirli <ehdemirli@proton.me>
Date: Wed, 9 Sep 2026 23:55:52 +0200
Subject: [PATCH 11/16] fix: fail pending commands on GCQ loss

---
 driver/amc_proxy.c                 | 31 ++++++++++++++++++++++++++----
 driver/amc_proxy.h                 |  2 ++
 driver/ami_amc_control.c           |  9 ++++++++-
 driver/fal/gcq/fw_if_gcq_amc.c     |  1 +
 driver/gcq-driver/src/gcq_driver.c |  6 +++++-
 5 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/driver/amc_proxy.c b/driver/amc_proxy.c
index 0b1c4a2..411e6c6 100644
--- a/driver/amc_proxy.c
+++ b/driver/amc_proxy.c
@@ -577,7 +577,7 @@ static void amc_proxy_cmd_complete(struct amc_proxy_instance *inst, struct com_q
 		}
 	}
         PR_ERR("No matching cid %d found, unexpected response", ccmd->hdr.cid);
-        mutex_unlock(&(inst->lock));
+	mutex_unlock(&(inst->lock));
 }
 
 /**
@@ -711,6 +711,23 @@ static void amc_proxy_submitted_cmd_check_timeout(struct amc_proxy_instance *ins
 	mutex_unlock(&(inst->lock));
 }
 
+static void amc_proxy_fail_submitted_cmds(struct amc_proxy_instance *inst)
+{
+	struct amc_proxy_cmd_struct *cmd = NULL;
+	struct list_head *pos = NULL, *next = NULL;
+
+	mutex_lock(&inst->lock);
+	list_for_each_safe(pos, next, &inst->submitted_cmds) {
+		cmd = list_entry(pos, struct amc_proxy_cmd_struct, cmd_list);
+		list_del_init(pos);
+		cmd->cmd_rcode = -ENODEV;
+		if (inst->event_cb)
+			inst->event_cb(inst->proxy_id,
+				AMC_PROXY_EVENT_TRANSPORT_ERROR, cmd);
+	}
+	mutex_unlock(&inst->lock);
+}
+
 /**
  * complete_response_thread() - the response thread
  *
@@ -726,6 +743,7 @@ static int complete_response_thread(void *data)
 {
         struct com_queue_entry ccmd;
         uint32_t ccmd_size = sizeof(struct com_queue_entry);
+	uint32_t ret = FW_IF_ERRORS_NONE;
         struct amc_proxy_instance *amc_proxy_inst = NULL;
         bool response_failed = false;
 
@@ -741,14 +759,19 @@ static int complete_response_thread(void *data)
                 if (response_failed == false) {
 
                         /* Perform the read from the FW_IF */
-                        if (amc_proxy_inst->fw_if_handle->read(amc_proxy_inst->fw_if_handle, 0,
-                                                        (uint8_t*)&ccmd,
-                                                        &ccmd_size, 0) == FW_IF_ERRORS_NONE) {
+                        ret = amc_proxy_inst->fw_if_handle->read(amc_proxy_inst->fw_if_handle, 0,
+							(uint8_t*)&ccmd,
+							&ccmd_size, 0);
+			if (ret == FW_IF_ERRORS_NONE) {
                                 /*
                                 * Get the entry from submitted_cmds list,
                                 * remove and invoke callback
                                 */
                                 amc_proxy_cmd_complete(amc_proxy_inst, &ccmd);
+			} else if (ret == FW_IF_GCQ_ERRORS_DRIVER_DEVICE_UNAVAILABLE) {
+				PR_ERR("GCQ transport is unavailable");
+				amc_proxy_fail_submitted_cmds(amc_proxy_inst);
+				response_failed = true;
                         }
 
                         /* Check for any commands that might have timed out & notify via callback */
diff --git a/driver/amc_proxy.h b/driver/amc_proxy.h
index 35d693e..8b51ba5 100644
--- a/driver/amc_proxy.h
+++ b/driver/amc_proxy.h
@@ -46,10 +46,12 @@ typedef int (amc_proxy_event_callback)(uint8_t proxy_id, uint8_t event_id, void*
  * enum amc_proxy_event - the events generated by the amc proxy layer
  * @AMC_PROXY_EVENT_RESPONSE_COMPLETE: completion event
  * @AMC_PROXY_EVENT_RESPONSE_TIMEOUT: timeout event
+ * @AMC_PROXY_EVENT_TRANSPORT_ERROR: GCQ transport failure event
  */
 enum amc_proxy_event {
         AMC_PROXY_EVENT_RESPONSE_COMPLETE = 0,
         AMC_PROXY_EVENT_RESPONSE_TIMEOUT,
+        AMC_PROXY_EVENT_TRANSPORT_ERROR,
 
         MAX_AMC_PROXY_EVENT
 };
diff --git a/driver/ami_amc_control.c b/driver/ami_amc_control.c
index 1f7e5fc..6d3b268 100644
--- a/driver/ami_amc_control.c
+++ b/driver/ami_amc_control.c
@@ -475,6 +475,10 @@ static int amc_proxy_callback(uint8_t proxy_id, uint8_t event_id, void* arg)
 		complete(req_complete);
 		break;
 
+	case AMC_PROXY_EVENT_TRANSPORT_ERROR:
+		complete(req_complete);
+		break;
+
 	default:
         	/* Unknown response */
 		ret = -EIO;
@@ -1590,9 +1594,12 @@ int submit_gcq_command(struct amc_control_ctxt *amc_ctrl_ctxt, enum gcq_submit_c
 
 	/* Check return code before reading response */
 	if (amc_proxy_cmd->cmd_rcode != 0) {
-		ret = -EINVAL;
+		ret = amc_proxy_cmd->cmd_rcode < 0 ?
+			amc_proxy_cmd->cmd_rcode : -EINVAL;
 		AMI_ERR(amc_ctrl_ctxt, "Request failed %d", amc_proxy_cmd->cmd_rcode);
 		amc_proxy_request_abort(amc_proxy_cmd);
+		if (ret == -ENODEV)
+			stop_gcq_services(amc_ctrl_ctxt);
 		goto done;
 	}
 
diff --git a/driver/fal/gcq/fw_if_gcq_amc.c b/driver/fal/gcq/fw_if_gcq_amc.c
index 6081ee2..7d5ac66 100644
--- a/driver/fal/gcq/fw_if_gcq_amc.c
+++ b/driver/fal/gcq/fw_if_gcq_amc.c
@@ -240,6 +240,7 @@ static FW_IF_GCQ_ERRORS_TYPE prvxMapIFDriverReturnCode( GCQ_ERRORS_TYPE xError )
         case GCQ_ERRORS_CONSUMER_NOT_AVAILABLE:     xMappedErr = FW_IF_GCQ_ERRORS_DRIVER_CONSUMER_NOT_AVAILABLE; break;
         case GCQ_ERRORS_CONSUMER_NO_DATA_RECEIVED:  xMappedErr = FW_IF_GCQ_ERRORS_DRIVER_CONSUMER_NO_DATA_RECEIVED; break;
         case GCQ_ERRORS_PRODUCER_NO_FREE_SLOTS:     xMappedErr = FW_IF_GCQ_ERRORS_DRIVER_PRODUCER_NO_FREE_SLOTS; break;
+        case GCQ_ERRORS_DEVICE_UNAVAILABLE:         xMappedErr = FW_IF_GCQ_ERRORS_DRIVER_DEVICE_UNAVAILABLE; break;
         case MAX_GCQ_ERRORS_TYPE:
         default:
             assert( 0 );
diff --git a/driver/gcq-driver/src/gcq_driver.c b/driver/gcq-driver/src/gcq_driver.c
index 1cc5a29..36228d8 100644
--- a/driver/gcq-driver/src/gcq_driver.c
+++ b/driver/gcq-driver/src/gcq_driver.c
@@ -319,7 +319,11 @@ static inline GCQ_ERRORS_TYPE prvxGCQConsume( GCQ_INSTANCE_TYPE *pxGCQInstance,
         /* Bind into the correct ring */
         pxRing = pxGCQInstance->pxGCQConsumer;
 
-        if( GCQ_TRUE == likely( prvucGCQCanConsume( pxGCQInstance, pxRing ) ) )
+        if( GCQ_FALSE == prvucGCQRegistersAvailable( pxGCQInstance ) )
+        {
+            xStatus = GCQ_ERRORS_DEVICE_UNAVAILABLE;
+        }
+        else if( GCQ_TRUE == likely( prvucGCQCanConsume( pxGCQInstance, pxRing ) ) )
         {
             *ullSlotAddr = prvullGCQRingGetSlotPtrConsumed( pxRing );
             pxRing->ulRingConsumed++;
